# Odoo credential kept only on the Linux server.
ODOO_BASE_URL=https://odoo.example.com
ODOO_DATABASE=odoo17
ODOO_LOGIN=claude.mcp@example.com
ODOO_API_KEY=replace-with-a-new-scoped-project-mcp-key
ODOO_MCP_AGENT=claude-code
ODOO_TIMEOUT_SECONDS=20
ODOO_VERIFY_TLS=true

# Permanent MCP HTTP service. Keep the application bound to loopback behind Caddy.
MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp
MCP_PUBLIC_URL=https://mcp.example.com/mcp
MCP_USERS_FILE=/var/lib/odoo-mcp/users.json
MCP_RATE_LIMIT_PER_MINUTE=120
MCP_STRICT_FILE_PERMISSIONS=true
MCP_FORWARDED_ALLOW_IPS=127.0.0.1,::1
MCP_ALLOW_PUBLIC_BIND=false

# Optional explicit allowlists. When omitted they are derived from MCP_PUBLIC_URL.
# MCP_ALLOWED_HOSTS=mcp.example.com
# MCP_ALLOWED_ORIGINS=https://mcp.example.com
